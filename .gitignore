/server/cover.out
/server/certs/*.crt
/server/certs/*.key
/server/.env
/server/**/*.sql
# ...except the canonical table definitions, which are source, not generated
# output: the CMS go:embeds them, so a checkout without them does not compile.
!/server/internal/database/schema/*.sql
/report.json
.vscode/settings.json
.codex
**/.codex

/.env
frontend/.env
server/data/
deploy/*.env
!deploy/*.env.example
..env.un~

# Local compose overrides (e.g. MEDIA_BASE_URL); never edit docker-compose.yml.
/docker-compose.override.yml

# Snapshot downloads for scripts/import_snapshot.py.
triangle-snapshot-*

# Local DB dumps (contain cms_users password hashes and cms_sessions).
# Kept here so Borg backs them up; /var/lib/docker volumes are NOT backed up.
db-backups/
