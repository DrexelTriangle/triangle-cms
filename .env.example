MARIADB_ROOT_PASSWORD=change-this-root-password
MARIADB_PASSWORD=change-this-db-password

# Authentik OIDC - required for auth on write endpoints.
OIDC_ISSUER_URL=<your-oidc-issuer-url>
OIDC_CLIENT_ID=<your-client-id>
OIDC_CLIENT_SECRET=<your-client-secret>
CMS_REBUILD_TAXONOMY_COUNTS_ON_STARTUP=false

# Slack moderation requires both a notification webhook and signing secret.
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=<your-slack-signing-secret>
# Optional link to the CMS queue from Slack notifications.
# SLACK_CLASSIFIEDS_QUEUE_URL=https://cms.thetriangle.org/classifieds

# Production configuration: deploy/cms.env.example. Keep secrets out of git.

# Optional overrides
# MARIADB_DATABASE=triangle
# MARIADB_USER=triangle_user
# MARIADB_PORT_FORWARD=3306
